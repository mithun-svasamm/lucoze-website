---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import LeadForm from "../../components/LeadForm.astro";
import "../../styles/contact-partner.css";

// What the help actually covers — set expectations, keep it honest.
const SEE: [string, string, string][] = [
	[
		"shield",
		"Where your facility stands on ABDM",
		"HFR (facility), HPR (your doctors) and ABHA at the front desk — what's done, and what's still left.",
	],
	[
		"map",
		"A clear, plain path to get set up",
		"The exact steps to get onto HFR, HPR and ABHA and start issuing ABHA-linked records — in plain language, no jargon.",
	],
	[
		"play",
		"Hands-on where you want it",
		"We'll walk you through the setup, and show how Lucoze issues ABHA-linked records inside the normal workflow. No obligation.",
	],
];

const TRUST: [string, string, string][] = [
	["clock", "15 minutes, one call", "With the team that builds Lucoze — not a call centre"],
	["shield", "No cost, no sales sequence", "Honest, practical help on where you stand"],
	["lock", "Data hosted in India", "ABDM-ready · DPDP-aligned"],
];
---

<Base
	title="Free ABDM setup help for HFR, HPR & ABHA"
	description="Getting your facility onto HFR, HPR and ABHA? We'll walk you through ABDM setup, help you get there, and show how Lucoze keeps you issuing ABHA-linked records. No cost to talk."
>
	<section class="reach-hero">
		<div class="container">
			<div class="reach-hero__grid">
				<div>
					<div class="reach-hero__eyebrow">
						<span class="reach-dot"></span> Free ABDM setup help
					</div>
					<h1 class="reach-hero__h1">
						Getting onto HFR, HPR &amp; ABHA?<br />We'll help you get set up.
					</h1>
					<p class="reach-hero__lead">
						ABDM is fast becoming the price of entry — HFR for your facility, HPR for your doctors,
						ABHA at the front desk. Tell us where you are, and we'll walk you through what's left and
						help you get set up. Then Lucoze keeps you issuing ABHA-linked records day to day. No cost
						to talk.
					</p>
				</div>

				<LeadForm
					heading="Get free ABDM setup help"
					submitLabel="Get help with ABDM"
					successHeading="Got it — we'll be in touch."
					successBody="The team will reach out within a day to help you get ABDM-ready. Prefer WhatsApp? Ping us anytime."
				/>
			</div>
		</div>
	</section>

	<section class="section section--tight">
		<div class="container" style="max-width: 1000px;">
			<div class="reach-bottom">
				<aside class="reach-expect">
					<div class="reach-expect__head">What we'll help with</div>
					{
						SEE.map(([ic, t, s]) => (
							<div class="reach-expect__row">
								<span class="reach-expect__ic">
									<Icon name={ic} size={19} />
								</span>
								<div>
									<div class="reach-expect__t">{t}</div>
									<div class="reach-expect__s">{s}</div>
								</div>
							</div>
						))
					}
					<div class="reach-expect__foot">
						<span class="reach-expect__sig">— The Lucoze team</span>
					</div>
				</aside>

				<div class="reach-trust">
					{
						TRUST.map(([ic, t, s]) => (
							<div class="reach-trust__item">
								<span class="reach-trust__ic">
									<Icon name={ic} size={18} />
								</span>
								<div>
									<div class="reach-trust__t">{t}</div>
									<div class="reach-trust__s">{s}</div>
								</div>
							</div>
						))
					}
				</div>
			</div>
		</div>
	</section>
</Base>

<script>
	import { initLeadForm } from "../../lib/lead-form";
	initLeadForm({ source: "abdm-setup-help", successHref: "/in/" });
</script>
